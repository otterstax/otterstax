# The Go harness (tests/flightsql_go, driven by tests/flightsql_e2e/
# test_go_driver.py) is PREBUILT in its own stage: arrow-go's module tree is
# heavy, and building it inline would re-download it on every python-test
# edit. The stage is cached by go.mod/go.sum alone.
FROM golang:1.26-bookworm AS goharness
WORKDIR /src
COPY ./tests/flightsql_go/go.mod ./tests/flightsql_go/go.sum ./
RUN go mod download
COPY ./tests/flightsql_go/main.go ./
RUN CGO_ENABLED=0 go build -o /out/flightsql_go .

FROM python:3.12-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    ca-certificates \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI (current) from Docker's official apt repo. The Kafka crash-recovery
# test (test_kafka_crash_recovery.py) drives `docker start`/`kill` against the
# HOST daemon via the mounted /var/run/docker.sock. Debian's `docker.io` package
# ships an old CLI (API 1.41) that a modern Docker Desktop daemon (min API 1.44)
# rejects — so install docker-ce-cli, which tracks the current API.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies including Faker
RUN pip install --no-cache-dir \
    pyarrow \
    flightsql-dbapi \
    # The FlightSQL e2e suite (tests/flightsql_e2e) drives the ORIGINAL Apache
    # drivers: adbc-driver-flightsql (Go/gRPC-Go) and pyarrow (above); the
    # protobuf stubs of the Flight messages are pre-generated next to the
    # suite, grpcio tools are only needed to regenerate them.
    adbc-driver-flightsql \
    pytest \
    grpcio \
    grpcio-tools \
    pymysql \
    # Pinned: 9.x is the last line whose connect-time handshake avoids
    # SELECT @@… system-variable probes the server's parser does not support;
    # the unpinned install started pulling 26.x (new date-based versioning)
    # after an image-layer rebuild and every MySQL-wire test died at connect
    # with "1149 syntax error at or near \"@@\"".
    mysql-connector-python==9.7.0 \
    "psycopg[binary]" \
    psycopg2-binary \
    clickhouse-driver \
    tabulate \
    faker \
    requests \
    confluent-kafka

# The prebuilt Go harness from its stage; a Go toolchain is NOT shipped in
# this image — the test runs the binary (go run stays the host-side fallback).
COPY --from=goharness /out/flightsql_go /usr/local/bin/flightsql_go

# Copy application files. All top-level tests/*.py (helpers + test_*.py) are
# pulled in via a single wildcard so a newly-added test doesn't need a matching
# COPY line — startup.sh remains the source of truth for which tests actually
# run. Subdirectories (scripts/, system/, unit/, minio/, mock/, mysql-front/)
# are intentionally excluded by the *.py glob — except the FlightSQL e2e suite
# and its Go harness, which docker-run-tests.sh runs via pytest / the binary.
COPY ./tests/scripts .
COPY ./tests/*.py .
COPY ./tests/flightsql_e2e ./flightsql_e2e
COPY ./tests/flightsql_go ./flightsql_go

RUN chmod +x /app/wait_for_otterstax.sh
RUN chmod +x /app/startup.sh

# Create directories where volumes will be mounted
RUN mkdir -p /app/mariadb1_init
RUN mkdir -p /app/mariadb2_init
RUN mkdir -p /app/postgres_init
RUN mkdir -p /app/clickhouse_init

# Tracy profiler port — expose on the server side when profiling integration runs
EXPOSE 8086

CMD ["./startup.sh"]
