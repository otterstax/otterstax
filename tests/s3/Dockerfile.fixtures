# Tiny aws-cli image variant that ships the external-table fixtures baked in at
# /fixtures, so the rustfs-init compose job can seed test-bucket without
# relying on a host bind mount (which is invisible to the docker daemon in
# DinD / sibling-container CI runners like Gitea act_runner).
FROM amazon/aws-cli:latest@sha256:eccdb3ec77e159d43ca6a750a70738c546883138be7f094498294a1477ec7e42

COPY tests/s3/fixtures /fixtures
