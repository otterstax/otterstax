sequenceDiagram
    title FlightSQL UPDATE Query Data Flow
    
    participant Client
    participant FlightSQL as FlightSQL Server
    participant Scheduler
    participant Catalog as Catalog Manager
    participant SqlConnMgr as SQL Connection Manager
    participant MySQL as MySQL Connector

    Client->>FlightSQL: DoPutCommandStatementUpdate(sql_update)
    activate FlightSQL
    FlightSQL->>Scheduler: execute(session_hash, sql_update)
    activate Scheduler

    Scheduler->>Scheduler: parse_query(sql_update)
    Note over Scheduler: Detects UPDATE/INSERT/DELETE

    Scheduler->>Catalog: get_catalog_schema(session_hash, parsed_data)
    activate Catalog
    Catalog->>Catalog: resolve_target_table
    Catalog-->>Scheduler: table_metadata
    deactivate Catalog

    Scheduler->>Scheduler: build_update_plan

    Scheduler->>SqlConnMgr: execute(update_query)
    activate SqlConnMgr
    SqlConnMgr->>MySQL: runQuery(sql_update)
    activate MySQL
    MySQL->>MySQL: execute_update()
    MySQL-->>SqlConnMgr: rows_affected(int64)
    deactivate MySQL
    SqlConnMgr-->>Scheduler: rows_affected
    deactivate SqlConnMgr

    Scheduler-->>FlightSQL: rows_affected
    deactivate Scheduler
    FlightSQL-->>Client: rows_affected
    deactivate FlightSQL
