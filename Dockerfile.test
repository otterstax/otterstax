FROM ubuntu:22.04 AS builder

ENV TZ=America/US
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONFAULTHANDLER=1

RUN apt update && \
    apt upgrade -y && \
    apt install -y \
        build-essential \
        ninja-build \
        git \
        pkg-config \
        libdbus-1-dev \
        python3-pip \
        python3-venv \
        python3-dev curl gnupg apt-transport-https \
        zlib1g \
        libssl-dev bison flex && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# cmake.org answers 403 to conan's HTTP client, so the conancenter cmake binary
# recipe cannot be fetched; the pip-installed cmake is declared as the platform
# tool_requires of the build profile instead (it satisfies the recipes' <4 range).
RUN pip3 install --no-cache-dir conan==2.21.0 'cmake<4.0' && \
     conan profile detect --force && \
     printf '\n[platform_tool_requires]\ncmake/%s\n' "$(cmake --version | head -1 | awk '{print $3}')" \
         >> "$(conan profile path default)" && \
     conan remote add otterbrix https://conan.otterbrix.com

RUN rm /bin/sh && ln -s /bin/bash /bin/sh

ARG BUILD_TYPE=Release
ARG WITH_TRACY=false
ARG WITH_PERF=false
ARG BUILD_JOBS=0
# TSAN_DEPS=true rebuilds otterbrix + actor-zeta, librdkafka and gRPC with
# abseil / protobuf / re2 from source with -fsanitize=thread (see
# tsan-deps.profile; the code generators protoc / grpc_cpp_plugin come from a
# plain build-context grpc / protobuf, so nothing instrumented runs at build time). Without it the prebuilt libraries' atomics are invisible
# to TSAN and the sanitizer job has no diagnostic power.
# It also switches all TSAN-instrumented code (deps and otterstax alike) to
# g++-12: gcc-11's libtsan misses the pthread_cond_clockwait interceptor
# (google/sanitizers#1259), yielding false "double lock" reports on every
# condition_variable::wait_for, and one process must link a single libtsan.
ARG TSAN_DEPS=false

RUN if [ "$TSAN_DEPS" = "true" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends g++-12 && \
        apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

# Run conan install from the project root so self.source_folder=/app and
# cmake_layout places generators + libs at build/${BUILD_TYPE}/ — matching
# the devcontainer preset layout exactly.
WORKDIR /app
COPY conanfile.py tsan-deps.profile ./
COPY cmake/conan-hooks/hook_librdkafka_c11threads_off.py ./conan-hooks/
# TEMPORARY (OTB-tag, docs/proposals/otterbrix-embedding.md): the pinned
# otterbrix/1.0.0b2-embedding.* exists only in the developer's local Conan
# cache. scripts/conan/export_local_packages.sh (run by docker-run-tests.sh and
# the benchmark scripts) archives its recipe + sources into
# .conan-local/local_recipes.tgz; when that archive is in the build context it
# is restored here and otterbrix is built from source. Without it (e.g. once an
# official tag is on the remote) the install falls back to the remotes
# unchanged. actor-zeta/2.0.0 is on the remote and resolves like any other
# dependency (--build missing builds it where the remote has no binary). The
# TSAN_DEPS branch builds otterbrix + actor-zeta from source regardless, to
# instrument them. The directory is tracked (.gitkeep), so the COPY never fails.
COPY .conan-local/ /tmp/conan-local/
# BUILD_JOBS caps conan's from-source builds too (tools.build:jobs): otterbrix
# needs ~1.5-2 GB per job — see CLAUDE.md "Build resources". BUILD_JOBS=0 means
# min(nproc, MemTotal_MB / 1536) of the build VM, never a bare nproc.
RUN _local_build=() && \
    if [ -f /tmp/conan-local/local_recipes.tgz ]; then \
        conan cache restore /tmp/conan-local/local_recipes.tgz && \
        _local_build=(--build="otterbrix/*"); \
    fi && \
    rm -rf /tmp/conan-local && \
    _jobs="${BUILD_JOBS}" && \
    if [ "$_jobs" = "0" ]; then \
        _mem_jobs=$(( $(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo) / 1536 )) && \
        if [ "$_mem_jobs" -lt 1 ]; then _mem_jobs=1; fi && \
        _jobs=$(( $(nproc) < _mem_jobs ? $(nproc) : _mem_jobs )); \
    fi && \
    echo "conan from-source build jobs: ${_jobs}" && \
    _jobs_conf=(-c "tools.build:jobs=${_jobs}") && \
    if [ "$TSAN_DEPS" = "true" ]; then \
        mkdir -p /root/.conan2/extensions/hooks && \
        cp ./conan-hooks/hook_librdkafka_c11threads_off.py /root/.conan2/extensions/hooks/ && \
        conan install conanfile.py --build missing "${_jobs_conf[@]}" \
            --build="otterbrix/*" --build="actor-zeta/*" --build="librdkafka/*" \
            -pr:h ./tsan-deps.profile \
            -s build_type=${BUILD_TYPE} \
            -s compiler.cppstd=gnu20 \
            -s 'clickhouse-cpp/*:compiler.cppstd=17' \
            -s 'abseil/*:compiler.cppstd=17' \
            -s 'protobuf/*:compiler.cppstd=17' \
            -s 're2/*:compiler.cppstd=17' \
            -s 'grpc/*:compiler.cppstd=17'; \
    elif [ "$WITH_TRACY" = "true" ]; then \
        conan install conanfile.py --build missing "${_local_build[@]}" "${_jobs_conf[@]}" \
            -s build_type=${BUILD_TYPE} \
            -s compiler.cppstd=gnu20 \
            -s 'clickhouse-cpp/*:compiler.cppstd=17' \
            -s 'abseil/*:compiler.cppstd=17' \
            -s 'protobuf/*:compiler.cppstd=17' \
            -s 're2/*:compiler.cppstd=17' \
            -s 'grpc/*:compiler.cppstd=17' \
            -o "&:with_tracy=True"; \
    else \
        conan install conanfile.py --build missing "${_local_build[@]}" "${_jobs_conf[@]}" \
            -s build_type=${BUILD_TYPE} \
            -s compiler.cppstd=gnu20 \
            -s 'clickhouse-cpp/*:compiler.cppstd=17' \
            -s 'abseil/*:compiler.cppstd=17' \
            -s 'protobuf/*:compiler.cppstd=17' \
            -s 're2/*:compiler.cppstd=17' \
            -s 'grpc/*:compiler.cppstd=17'; \
    fi

# Install perf tools when WITH_PERF=true.
# linux-tools-generic ships perf 5.15; it runs on the Docker Desktop linuxkit kernel
# (currently 6.12.x) without issues for software events and syscall tracepoints.
RUN if [ "$WITH_PERF" = "true" ]; then \
    apt-get update && \
    apt-get install -y --no-install-recommends linux-tools-generic linux-tools-common && \
    ln -sf "$(find /usr/lib/linux-tools -name perf | sort -V | tail -1)" /usr/local/bin/perf && \
    rm -rf /var/lib/apt/lists/*; \
fi

# Build tracy-capture CLI when Tracy is enabled
RUN _jobs="${BUILD_JOBS}" && \
    if [ "$_jobs" = "0" ]; then \
        _mem_jobs=$(( $(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo) / 1536 )) && \
        if [ "$_mem_jobs" -lt 1 ]; then _mem_jobs=1; fi && \
        _jobs=$(( $(nproc) < _mem_jobs ? $(nproc) : _mem_jobs )); \
    fi && \
    if [ "$WITH_TRACY" = "true" ]; then \
        curl -L https://github.com/wolfpld/tracy/archive/refs/tags/v0.13.1.tar.gz \
            | tar xz -C /tmp && \
        cmake -S /tmp/tracy-0.13.1/capture -B /tmp/tracy-capture-build \
            -DCMAKE_BUILD_TYPE=Release \
            -DNFD_PORTAL=ON && \
        cmake --build /tmp/tracy-capture-build -j${_jobs} && \
        cp /tmp/tracy-capture-build/tracy-capture /usr/local/bin/ && \
        rm -rf /tmp/tracy-0.13.1 /tmp/tracy-capture-build; \
    fi

COPY ./catalog ./catalog
COPY ./config ./config
COPY ./connectors ./connectors
COPY ./integration ./integration
COPY ./frontend/ ./frontend
COPY ./otterbrix ./otterbrix
COPY ./runtime ./runtime
COPY ./backends ./backends
COPY ./session ./session
COPY ./types ./types
COPY ./utility ./utility
COPY ./cmake ./cmake
COPY ./main.cpp ./main.cpp
COPY ./CMakeLists.txt ./CMakeLists.txt
COPY ./tests ./tests
# Only what BUILD_BENCHMARKS=ON compiles; the compose/scripts half of benchmark/ stays out.
COPY ./benchmark/CMakeLists.txt ./benchmark/CMakeLists.txt
COPY ./benchmark/microbench ./benchmark/microbench
COPY ./tsan.supp ./tsan.supp

ARG ENABLE_ASAN=OFF
ARG ENABLE_TSAN=OFF
# ON compiles benchmark/microbench (otterstax_bench) as well; nothing runs it.
ARG BUILD_BENCHMARKS=OFF

# TSAN suppressions for known-bad third-party code (see tsan.supp).
# Only takes effect in TSAN builds; plain Release / ASAN ignore it.
ENV TSAN_OPTIONS="suppressions=/app/tsan.supp"

RUN _jobs="${BUILD_JOBS}" && \
    if [ "$_jobs" = "0" ]; then \
        _mem_jobs=$(( $(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo) / 1536 )) && \
        if [ "$_mem_jobs" -lt 1 ]; then _mem_jobs=1; fi && \
        _jobs=$(( $(nproc) < _mem_jobs ? $(nproc) : _mem_jobs )); \
    fi && \
    _tracy=$([ "${WITH_TRACY}" = "true" ] && echo "ON" || echo "OFF") && \
    _perf=$([ "${WITH_PERF}" = "true" ] && echo "ON" || echo "OFF") && \
    _cc=$([ "${TSAN_DEPS}" = "true" ] && echo "-DCMAKE_C_COMPILER=gcc-12 -DCMAKE_CXX_COMPILER=g++-12" || echo "") && \
    cmake -S . -B build/${BUILD_TYPE} ${_cc} \
        -DCMAKE_TOOLCHAIN_FILE=build/${BUILD_TYPE}/generators/conan_toolchain.cmake \
        -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_TESTS=ON \
        -DBUILD_BENCHMARKS=${BUILD_BENCHMARKS} \
        -DENABLE_ASAN=${ENABLE_ASAN} \
        -DENABLE_TSAN=${ENABLE_TSAN} \
        -DENABLE_TRACY=${_tracy} \
        -DENABLE_PERF=${_perf} && \
    cmake --build build/${BUILD_TYPE} --target all -- -j${_jobs}

WORKDIR /app/build/${BUILD_TYPE}

# Tracy-enabled builds skip tests: Tracy's profiler init crashes in a headless
# Docker container (no profiler server attached). Non-Tracy CI builds run all tests.
# RUN_TESTS=false skips them too: a TSAN image built on arm64, whose instrumented
# binaries cannot run under docker build's seccomp filter (personality
# ADDR_NO_RANDOMIZE, see CLAUDE.md "The TSAN image") — its tests run in a
# container started with --security-opt seccomp=unconfined instead.
ARG WITH_TRACY=false
ARG RUN_TESTS=true
RUN if [ "${WITH_TRACY}" = "true" ]; then \
        echo "Skipping tests: Tracy build (headless Docker, no profiler attached)"; \
    elif [ "${RUN_TESTS}" != "true" ]; then \
        echo "Skipping tests: RUN_TESTS=${RUN_TESTS}"; \
    else \
        ctest -C ${BUILD_TYPE} --output-on-failure --timeout 120; \
    fi

# External-table fixtures baked into the image so the file/s3 tests work in CI
# runners where the docker daemon cannot see the host workspace (DinD / sibling
# containers). Kept after the build so editing fixtures does not invalidate the
# expensive build layers.
COPY ./tests/minio/fixtures /fixtures

# Single config file (server settings + connections) baked into the image at the
# server's default config path (config.yaml, relative to WORKDIR
# /app/build/${BUILD_TYPE}). Read once at startup — the single source of truth
# for the integration-test backends/s3 alias (docker-DNS hostnames on the test
# network). Baking rather than bind-mounting so it works in DinD CI runners.
COPY ./tests/scripts/config.yaml ./config.yaml

# Tracy profiler port (active only when built with --build-arg WITH_TRACY=true)
EXPOSE 8086

CMD [ "./server" ]
