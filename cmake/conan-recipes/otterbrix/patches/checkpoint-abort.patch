+        if (txn_id < TRANSACTION_ID_START || count > UINT64_MAX - start_row) return false;
+        const auto end = start_row + count;
+        // Validate ownership before changing any stamp. An obsolete undo range
+        // must not erase a row committed or inserted by another transaction.
+        for (auto row = start_row; row < end; ++row) {
+            auto* info = get_chunk_info(row / vector::DEFAULT_VECTOR_CAPACITY);
+            if (!info) return false;
+            const auto inserted = info->type == chunk_info_type::CONSTANT_INFO
+                ? info->cast<chunk_constant_info>().insert_id
+                : info->cast<chunk_vector_info>().inserted[row % vector::DEFAULT_VECTOR_CAPACITY];
+            if (inserted != txn_id) return false;
+        }
+        for (auto row = start_row; row < end;) {
+            auto& info = vector_info(row / vector::DEFAULT_VECTOR_CAPACITY);
+            const auto offset = row % vector::DEFAULT_VECTOR_CAPACITY;
+            const auto length = std::min(end - row, vector::DEFAULT_VECTOR_CAPACITY - offset);
+            // Inserted and deleted at stamp zero is invisible to every snapshot,
+            // including snapshots older than the abort. Unlike a pending txn id,
+            // these tombstones do not hold back the checkpoint watermark.
+            info.same_inserted_id = false;
+            info.insert_id = NOT_DELETED_ID;
+            info.any_deleted = true;
+            for (auto i = offset; i < offset + length; ++i) {
+                info.inserted[i] = 0;
+                info.deleted[i] = 0;
+            }
+            row += length;
+        }
+        has_changes_ = true;
+        return true;
+    }
