sequenceDiagram
    title MySQL Protocol SELECT Query Data Flow
    
    participant Client
    participant MySQLSrv as MySQL Server
    participant Scheduler
    participant Catalog as Catalog Manager
    participant SqlConnMgr as SQL Connection Manager
    participant MySQL as MySQL Connector

    Client->>MySQLSrv: COM_QUERY(sql_select)
    activate MySQLSrv
    MySQLSrv->>Scheduler: execute(session_hash, sql)
    activate Scheduler

    Scheduler->>Scheduler: parse_query(sql)
    Scheduler->>Catalog: get_catalog_schema(session_hash, parsed_data)
    activate Catalog
    Catalog-->>Scheduler: schema_metadata
    deactivate Catalog

    Scheduler->>Scheduler: build_execution_plan

    Scheduler->>SqlConnMgr: execute(query)
    activate SqlConnMgr
    SqlConnMgr->>MySQL: runQuery(sql)
    activate MySQL
    MySQL-->>SqlConnMgr: result_chunk
    deactivate MySQL
    SqlConnMgr-->>Scheduler: result_cursor
    deactivate SqlConnMgr

    Scheduler-->>MySQLSrv: result_data
    deactivate Scheduler

    MySQLSrv->>MySQLSrv: encode_result_packet()
    MySQLSrv-->>Client: ResultSet(rows)
    deactivate MySQLSrv
