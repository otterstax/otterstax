# ThreadSanitizer suppressions.
#
# Activated in sanitizer builds via TSAN_OPTIONS=suppressions=/app/tsan.supp
# (see Dockerfile.test).

# otterbrix bundles spdlog, which double-locks its periodic_worker mutex during destruction.
called_from_lib:libotterbrix_log.so
mutex:initialize_all_loggers

# TODO: remove with cv_wrapper after move to actors
mutex:cv_wrapper::cv_wrapper_t
mutex:cv_wrapper_t

# boost::lockfree freelist tagged-pointer reuse: a designed-in speculative read
# discarded by the ABA-protected CAS — correct but not expressible to TSAN.
# The engine's actor inboxes and the buffer-pool eviction queue sit on
# boost::lockfree::queue (including the Scheduler event-loop inbox_).
race:boost::lockfree

# Test mocks (tests/mock/parser.hpp, mock/otterbrix.hpp, mock/*_db_connector.hpp)
# print debug lines to std::cout. With the Scheduler→Worker pool these now run on
# several pool threads concurrently and race on the shared std::cout stream. This
# is mock-only noise — production logging goes through thread-safe spdlog — and the
# interleaved output is harmless.
race:std::__1::__put_character_sequence
race:std::__1::ios_base::width

# Arrow's JSON TableReader (and the IO read-ahead pipeline behind it) spawns
# a BackgroundGenerator worker thread to feed buffer chunks, even when we set
# ReadOptions::use_threads=false. That thread races with the main thread on
# the generator's State / Mutex and on the Result<shared_ptr<Buffer>> slots in
# its internal deque during teardown of the reader. Both sides of the race are
# inside libarrow — no otterstax frame participates. Hit by ndjson_to_chunk
# (file + buffer overloads) and shows up in test_unit_translators.
race:arrow::BackgroundGenerator
race:arrow::Result

# Same class of arrow-internal teardown race, CSV/Parquet flavour. The
# TableReader drives conversion through arrow's global CPU thread pool behind
# an arrow::Future; during reader teardown that future's shared state (control
# block) is released on an arrow worker thread (std::_Sp_counted_base::_M_release,
# inside libarrow) while the main thread is still parked in FutureImpl::Wait().
# Both racing accesses are in libarrow — the only otterstax frame is the
# csv_to_chunk caller of Wait(). Hit by csv_to_chunk (test_file_ingestion /
# "FileManager: csv dump and re-read" in test_system).
race:arrow::FutureImpl

# librdkafka's rk_terminate flag: rd_kafka_destroy() sets it, its background
# thread (rd_kafka_thread_main) polls it to exit — harmless (monotonic flag,
# atomic on x86). librdkafka's rdatomic.h writes it non-atomically but reads it
# atomically, so TSAN flags the handshake; third-party static lib, suppress by name.
race:rd_atomic32_set
race:rd_atomic32_get
race:rd_atomic64_set
race:rd_atomic64_get
