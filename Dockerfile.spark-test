#
# Test client image with PySpark + JVM for Spark Connect (port 15002) E2E tests.
# Mirrors Dockerfile.integration-test (flat /app layout, runs startup.sh) but adds
# OpenJDK 17 + pyspark so the test_spark_client_*.py scripts can run alongside
# the rest of the suite.

FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PYSPARK_PYTHON=python3

ARG PYSPARK_VERSION=4.0.0
# pyspark[connect] pulls the full Spark Connect client stack the test scripts need:
# pandas, pyarrow, grpcio, grpcio-status, googleapis-common-protos, numpy.
RUN pip install --no-cache-dir \
    "pyspark[connect]==${PYSPARK_VERSION}" \
    pyarrow \
    "pandas>=2.0.0" \
    flightsql-dbapi \
    pymysql \
    mysql-connector-python \
    "psycopg[binary]" \
    psycopg2-binary \
    clickhouse-driver \
    tabulate \
    faker \
    requests

WORKDIR /app

# Copy application files (same flat layout as Dockerfile.integration-test so
# startup.sh and run_test resolve every script by bare filename).
COPY ./tests/scripts .
COPY ./tests/create_test_data.py .
COPY ./tests/query_data.py .
COPY ./tests/config.py .

# Schema tests
COPY ./tests/test_schema_flightsql_client_mysql_backend.py .
COPY ./tests/test_schema_flightsql_client_pg_backend.py .
COPY ./tests/test_schema_flightsql_client_ch_backend.py .
COPY ./tests/test_schema_cross_backend.py .

# x_client_y_backend functional tests
COPY ./tests/test_flightsql_client_mysql_backend.py .
COPY ./tests/test_flightsql_client_mysql_backend_mutable.py .
COPY ./tests/test_flightsql_client_pg_backend.py .
COPY ./tests/test_flightsql_client_ch_backend.py .
COPY ./tests/test_mysql_client_mysql_backend.py .
COPY ./tests/test_pg_client_mysql_backend.py .
COPY ./tests/test_pg_client_pg_backend.py .
COPY ./tests/test_mysql_client_pg_backend.py .
COPY ./tests/test_mysql_client_ch_backend.py .
COPY ./tests/test_pg_client_ch_backend.py .

# Cross-backend JOIN tests
COPY ./tests/test_cross_backend_queries.py .
COPY ./tests/test_cross_backend_queries_pg.py .

# Spark Connect E2E tests
COPY ./tests/test_spark_client_mysql_backend.py .
COPY ./tests/test_spark_client_pg_backend.py .
COPY ./tests/test_spark_client_cross_backend.py .

# Concurrency / stress tests
COPY ./tests/test_concurrency.py .
COPY ./tests/test_stress.py .

RUN chmod +x /app/http_healthcheck.sh
RUN chmod +x /app/add_connections.sh
RUN chmod +x /app/startup.sh

# Create directories where volumes will be mounted
RUN mkdir -p /app/mariadb1_init
RUN mkdir -p /app/mariadb2_init
RUN mkdir -p /app/postgres_init
RUN mkdir -p /app/clickhouse_init

CMD ["./startup.sh"]
