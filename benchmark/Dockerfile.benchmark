FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --timeout 120 --retries 5 \
    mysql-connector-python \
    psycopg2-binary \
    flightsql-dbapi \
    pyarrow \
    pymysql \
    clickhouse-driver \
    confluent-kafka \
    faker \
    pyyaml

COPY benchmark/bench.yaml   /app/bench.yaml
COPY benchmark/data/       /app/data/
COPY benchmark/benchmarks/  /app/benchmarks/
COPY benchmark/scripts/     /app/scripts/
COPY benchmark/stress/      /app/stress/

RUN chmod +x /app/scripts/*.sh \
 && chmod +x /app/stress/run_stress_benchmarks.sh

CMD ["python", "--version"]
